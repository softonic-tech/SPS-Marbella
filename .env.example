# Public site URL — used for canonical links, Open Graph tags,
# sitemap.xml and robots.txt. Set this to the live domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin
ADMIN_PASSWORD=sps-admin

# Public HTTPS origin for OAuth redirects + Meta image fetch (ngrok or production).
# No trailing slash. Must match Meta app redirect URIs exactly.
BASE_URL=https://your-tunnel.ngrok-free.app
SESSION_SECRET=

# MongoDB (recommended for tokens, refresh expiry, uploads, drafts).
# If unset, falls back to local data/social.json + public/uploads.
MONGODB_URI=

# Meta / Facebook Login (same keys as mm-properties)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Optional: Facebook Login for Business config
META_LOGIN_CONFIG_ID=

# Optional allowlists — empty means any user Meta allows (testers in Development / anyone after Live).
# Comma-separated for multiple client accounts:
# ALLOWED_FACEBOOK_USER_IDS=111,222
# ALLOWED_FACEBOOK_USER_ID=
# ALLOWED_INSTAGRAM_USER_IDS=
# ALLOWED_INSTAGRAM_USER_ID=

# OAuth redirect URI to paste in Meta → Facebook Login → Settings:
# ${BASE_URL}/facebook-callback.html
#
# Instagram (preferred): same Meta / Facebook app as above.
# 1. Link an Instagram Business/Creator account to the Facebook Page in Meta Business Suite.
# 2. In the Meta app, add Instagram permissions: instagram_basic, instagram_content_publish
#    (plus the existing Page permissions used for Facebook posts).
# 3. Reconnect Facebook in /admin, then click Connect Instagram (links from the Page).
# No INSTAGRAM_APP_ID is required for that path.

# Optional: Instagram API with Instagram Login (separate App ID / Secret)
# Only needed if you are not linking Instagram through the Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional override (defaults to ${BASE_URL}/api/instagram-callback)
# INSTAGRAM_REDIRECT_URI=
# Also set in Meta Instagram product:
# Deauthorize:   ${BASE_URL}/api/instagram-deauthorize
# Data deletion: ${BASE_URL}/api/instagram-data-deletion
